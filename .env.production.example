# ═══════════════════════════════════════════════════════════
# Big Starz Casting App — Production Environment Template
# ═══════════════════════════════════════════════════════════
# ⚠️  NEVER commit real values to version control.
#    Copy this file to .env.production and fill in secrets.
# ═══════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────
# Database (RDS / Cloud SQL / PlanetScale)
# ───────────────────────────────────────────────────────────
DATABASE_URL=postgresql://bigstarz:YOUR_DB_PASSWORD@your-db-host:5432/bigstarz?sslmode=require

# Read replica (optional, for scaling reads)
# DATABASE_READ_URL=postgresql://bigstarz:YOUR_DB_PASSWORD@your-replica-host:5432/bigstarz?sslmode=require

# ───────────────────────────────────────────────────────────
# Redis (ElastiCache / Memorystore / Redis Cloud)
# ───────────────────────────────────────────────────────────
REDIS_URL=redis://your-redis-host:6379

# Redis sentinel config (for HA)
# REDIS_SENTINEL_HOSTS=sentinel-1:26379,sentinel-2:26379,sentinel-3:26379
# REDIS_SENTINEL_MASTER_NAME=mymaster

# ───────────────────────────────────────────────────────────
# JWT Secrets (generate with: openssl rand -base64 64)
# ───────────────────────────────────────────────────────────
JWT_SECRET=YOUR_JWT_SECRET_HERE_64_BYTES_MINIMUM_PLEASE
JWT_REFRESH_SECRET=YOUR_JWT_REFRESH_SECRET_HERE_64_BYTES_MINIMUM_PLEASE

# Token expiration (seconds)
# JWT_ACCESS_EXPIRATION=900
# JWT_REFRESH_EXPIRATION=604800

# ───────────────────────────────────────────────────────────
# HuggingFace (free tier token)
# Get token: https://huggingface.co/settings/tokens
# ───────────────────────────────────────────────────────────
HUGGINGFACE_API_TOKEN=hf_YOUR_HUGGINGFACE_TOKEN

# Model endpoints (defaults shown, override if needed)
HF_MODEL_TEXT=mistralai/Mistral-7B-Instruct-v0.2
HF_MODEL_IMAGE=stabilityai/stable-diffusion-xl-base-1.0
HF_MODEL_VIDEO=stabilityai/stable-video-diffusion-img2vid-xt
HF_MODEL_STT=openai/whisper-large-v3
HF_MODEL_TTS=microsoft/speecht5_tts

# ───────────────────────────────────────────────────────────
# Stripe (LIVE keys — test with test keys in dev)
# ───────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_YOUR_STRIPE_LIVE_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_STRIPE_WEBHOOK_SECRET

# Stripe price IDs (create in Stripe Dashboard)
STRIPE_PRICE_BRONZE=price_YOUR_BRONZE_PRICE_ID
STRIPE_PRICE_SILVER=price_YOUR_SILVER_PRICE_ID
STRIPE_PRICE_GOLD=price_YOUR_GOLD_PRICE_ID

# ───────────────────────────────────────────────────────────
# S3 / Object Storage (AWS S3 / MinIO / Cloudflare R2)
# ───────────────────────────────────────────────────────────
S3_BUCKET=bigstarz-prod-uploads
S3_REGION=us-east-1
S3_ACCESS_KEY=AKIAYOUR_ACCESS_KEY
S3_SECRET_KEY=YOUR_SECRET_ACCESS_KEY

# S3 endpoint (for non-AWS providers like MinIO or R2)
# S3_ENDPOINT=https://s3.us-east-1.amazonaws.com

# ───────────────────────────────────────────────────────────
# Domain & SSL
# ───────────────────────────────────────────────────────────
DOMAIN_NAME=app.bigstarz.com
API_DOMAIN=api.bigstarz.com

# SSL certificate (Let's Encrypt auto-managed by cert-manager in K8s)
# Or manual cert paths for Docker:
# SSL_CERT_PATH=/etc/ssl/certs/bigstarz.crt
# SSL_KEY_PATH=/etc/ssl/private/bigstarz.key

# ───────────────────────────────────────────────────────────
# Application URLs
# ───────────────────────────────────────────────────────────
API_URL=https://api.bigstarz.com
APP_URL=https://app.bigstarz.com
NEXT_PUBLIC_API_URL=https://api.bigstarz.com/api/v1
NEXT_PUBLIC_APP_URL=https://app.bigstarz.com
CORS_ORIGIN=https://app.bigstarz.com

# ───────────────────────────────────────────────────────────
# Node.js Environment
# ───────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001

# ───────────────────────────────────────────────────────────
# Monitoring & Observability (optional)
# ───────────────────────────────────────────────────────────
# SENTRY_DSN=https://...@sentry.io/...
# SENTRY_ENVIRONMENT=production
# LOG_LEVEL=info
# LOG_FORMAT=json

# ───────────────────────────────────────────────────────────
# Email / SMTP (for notifications)
# ───────────────────────────────────────────────────────────
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=YOUR_SENDGRID_API_KEY
# SMTP_FROM=noreply@bigstarz.com

# ───────────────────────────────────────────────────────────
# Backup Configuration
# ───────────────────────────────────────────────────────────
# AWS_ACCESS_KEY_ID=YOUR_BACKUP_ACCESS_KEY
# AWS_SECRET_ACCESS_KEY=YOUR_BACKUP_SECRET_KEY
# AWS_DEFAULT_REGION=us-east-1
BACKUP_S3_BUCKET=bigstarz-backups
BACKUP_RETENTION_DAYS=30

# ───────────────────────────────────────────────────────────
# Feature Flags
# ───────────────────────────────────────────────────────────
# ENABLE_AI_GENERATION=true
# ENABLE_STRIPE_WEBHOOKS=true
# ENABLE_ANALYTICS=true
# ENABLE_RATE_LIMITING=true
