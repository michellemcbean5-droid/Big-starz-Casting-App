# HuggingFace API Token (free — get yours at https://huggingface.co/settings/tokens)
HF_API_TOKEN=your_huggingface_token_here

# Model Configuration (all free-tier HuggingFace models)
HF_MODEL_TEXT=mistralai/Mistral-7B-Instruct-v0.2
HF_MODEL_IMAGE=stabilityai/stable-diffusion-xl-base-1.0
HF_MODEL_VIDEO=stabilityai/stable-video-diffusion-img2vid-xt
HF_MODEL_STT=openai/whisper-large-v3
HF_MODEL_TTS=microsoft/speecht5_tts
HF_MODEL_FACE=facebook/dinov2-large
HF_MODEL_EMBEDDING=sentence-transformers/all-MiniLM-L6-v2

# Output Directories
OUTPUT_DIR=./outputs
TEMP_DIR=./temp

# Logging
LOG_LEVEL=info

# Safety Filter Thresholds (0.0 - 1.0)
SAFETY_NSFW_THRESHOLD=0.7
SAFETY_HATE_THRESHOLD=0.8
SAFETY_VIOLENCE_THRESHOLD=0.7
SAFETY_COPYRIGHT_THRESHOLD=0.6
