# Big Starz Casting App — Backend Environment Variables

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/bigstarz?schema=public

# JWT Secrets (generate strong random strings)
JWT_SECRET=your_jwt_secret_key_here_min_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here_min_32_chars

# Token Expiration
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Server
PORT=3001
NODE_ENV=development

# HuggingFace AI Models
HUGGINGFACE_API_TOKEN=your_huggingface_api_token_here
HF_MODEL_TEXT=mistralai/Mistral-7B-Instruct-v0.2
HF_MODEL_IMAGE=stabilityai/stable-diffusion-xl-base-1.0
HF_MODEL_VIDEO=stabilityai/stable-video-diffusion-img2vid-xt
HF_MODEL_STT=openai/whisper-large-v3
HF_MODEL_TTS=microsoft/speecht5_tts

# Stripe (Payments)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# Storage (S3-compatible)
S3_BUCKET=bigstarz-dev
S3_REGION=us-east-1
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key
S3_ENDPOINT=http://localhost:9000

# Email (SMTP or SendGrid)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_api_key
FROM_EMAIL=noreply@bigstarz.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:3002

# Logging
LOG_LEVEL=debug
