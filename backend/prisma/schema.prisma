generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// [4m Enums [0m [4m[0m[4m[0m[4m[0m[4m[0m[4m[0m[4m[0m[4m[0m[4m[0m[4m[0m[4m[0m[4m[0m[4m[0m[4m[0m[4m

enum UserRole {
  TALENT
  CASTING_DIRECTOR
  CREATOR
  ADMIN
}

enum CastingCallStatus {
  DRAFT
  OPEN
  CLOSED
  FILLED
}

enum CastingCallType {
  FILM
  TV
  COMMERCIAL
  MUSIC_VIDEO
  THEATER
  DIGITAL
}

enum ApplicationStatus {
  PENDING
  REVIEWING
  SHORTLISTED
  REJECTED
  HIRED
}

enum UnionStatus {
  SAG_AFTRA
  NON_UNION
  EQUITY
  AFTRA
  OTHER
}

enum DigitalTwinStatus {
  TRAINING
  READY
  ERROR
}

enum SubscriptionTier {
  FREE
  BRONZE
  SILVER
  GOLD
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
}

enum ContractType {
  TALENT
  AI_CONSENT
  DIGITAL_TWIN
  CASTING_DIRECTOR
  ADVERTISER
}

enum ContractStatus {
  PENDING
  SIGNED
  EXPIRED
  REVOKED
}

enum EarningSource {
  AD_REVENUE
  ENGAGEMENT
  REFERRAL
  CASTING_FEE
}

enum EarningStatus {
  PENDING
  PAID
  FAILED
}

enum AiGenerationType {
  SCENE
  REEL
  MUSIC_VIDEO
  DIGITAL_TWIN
  ENHANCEMENT
}

enum AiGenerationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum DMCATakedownStatus {
  PENDING
  REVIEWING
  REMOVED
  REJECTED
}

// Skill Enums
enum SkillCategory {
  AI_ARCHITECTURE
  BACKEND_INFRASTRUCTURE
  FULLSTACK_MOBILE
  DEVOPS_CLOUD
  SECURITY_COMPLIANCE
  DATA_ANALYTICS
  PERFORMANCE_OPTIMIZATION
  GENERATIVE_AI
  SYSTEM_DESIGN
  PRODUCTION_DEPLOYMENT
}

enum SkillProficiency {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

// [4m Core Models [0m [4m[0m[4m[0m[4m[0m[4m[0m[4m[0m[4m[0m[4m[0m[4m[0m[4m[0m[4m[0m[4m[0m[4m[0m[4m

model User {
  id             String    @id @default(uuid())
  email          String    @unique
  passwordHash   String
  role           UserRole  @default(TALENT)
  emailVerified  Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  profile               Profile?
  applications          Application[]
  castingCalls          CastingCall[]
  digitalTwins          DigitalTwin[]
  subscriptions         Subscription[]
  contracts             Contract[]
  earnings              Earning[]
  aiGenerations         AiGeneration[]
  auditLogs             AuditLog[]
  masterCodesCreated    MasterCode[]

  @@map("users")
}

model Profile {
  id             String   @id @default(uuid())
  userId         String   @unique
  firstName      String?
  lastName       String?
  displayName    String?
  avatarUrl      String?
  bio            String?
  location       String?
  phone          String?
  dateOfBirth    DateTime?
  isMinor        Boolean  @default(false)
  guardianName   String?
  guardianEmail  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  talentProfile   TalentProfile?
  castingDirector CastingDirectorProfile?

  @@map("profiles")
}

model TalentProfile {
  id              String     @id @default(uuid())
  profileId       String     @unique
  stageName       String?
  unionStatus     UnionStatus @default(NON_UNION)
  skills          String[]
  experienceYears Int?
  height          String?
  weight          String?
  ethnicity       String?
  languages       String[]
  reelUrl         String?
  portfolioUrls   String[]
  availability    String?
  isFeatured      Boolean    @default(false)
  rankingScore    Float      @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  // Relations
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  talentSkills TalentSkill[]

  @@map("talent_profiles")
}

model CastingDirectorProfile {
  id              String   @id @default(uuid())
  profileId       String   @unique
  companyName     String?
  companyWebsite  String?
  credits         String[]
  verified        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("casting_director_profiles")
}

// [4m Skills Models [0m

model Skill {
  id          String         @id @default(uuid())
  name        String         @unique
  description String?
  category    SkillCategory
  tags        String[]
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  // Relations
  talentSkills TalentSkill[]
  castingCallSkills CastingCallSkill[]

  @@index([name])
  @@index([category])
  @@map("skills")
}

model TalentSkill {
  id           String   @id @default(uuid())
  talentProfileId String
  skillId      String
  proficiency  SkillProficiency @default(BEGINNER)
  yearsExperience Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  talentProfile TalentProfile @relation(fields: [talentProfileId], references: [id], onDelete: Cascade)
  skill         Skill         @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([talentProfileId, skillId])
  @@index([talentProfileId])
  @@index([skillId])
  @@map("talent_skills")
}

model CastingCallSkill {
  id           String   @id @default(uuid())
  castingCallId String
  skillId      String
  required     Boolean  @default(false)
  weight       Float    @default(1.0)
  createdAt    DateTime @default(now())

  // Relations
  castingCall CastingCall @relation(fields: [castingCallId], references: [id], onDelete: Cascade)
  skill       Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([castingCallId, skillId])
  @@index([castingCallId])
  @@index([skillId])
  @@map("casting_call_skills")
}

// [4m Casting [0m [4m[0m[4m[0m[4m[0m[4m[0m[4m[0m[4m[0m[4m[0m[4m[0m[4m[0m[4m[0m[4m[0m[4m

model CastingCall {
  id            String            @id @default(uuid())
  title         String
  description   String
  directorId    String
  status        CastingCallStatus @default(DRAFT)
  type          CastingCallType
  location      String?
  remoteOk      Boolean           @default(false)
  budget        Float?
  compensation  String?
  deadline      DateTime?
  requirements  Json?
  roles         Json?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  // Relations
  director      User          @relation(fields: [directorId], references: [id], onDelete: Cascade)
  applications  Application[]
  castingCallSkills CastingCallSkill[]

  @@map("casting_calls")
}

model Application {
  id           String            @id @default(uuid())
  talentId     String
  castingCallId String
  status       ApplicationStatus @default(PENDING)
  coverLetter  String?
  videoUrl     String?
  notes        String?
  submittedAt  DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  // Relations
  talent      User        @relation(fields: [talentId], references: [id], onDelete: Cascade)
  castingCall CastingCall @relation(fields: [castingCallId], references: [id], onDelete: Cascade)

  @@unique([talentId, castingCallId])
  @@map("applications")
}

// [4m Digital Twin [0m [4m[0m[4m[0m[4m[0m[4m[0m[4m[0m[4m[0m[4m[0m[4m[0m[4m[0m[4m[0m[4m[0m[4m

model DigitalTwin {
  id              String            @id @default(uuid())
  talentId        String
  name            String
  description     String?
  modelData       Json?
  thumbnailUrl    String?
  consentSigned   Boolean           @default(false)
  consentSignedAt DateTime?
  status          DigitalTwinStatus @default(TRAINING)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  // Relations
  talent User @relation(fields: [talentId], references: [id], onDelete: Cascade)

  @@map("digital_twins")
}

// [4m Monetization [0m [4m[0m[4m[0m[4m[0m[4m[0m[4m[0m[4m[0m[4m[0m[4m[0m[4m[0m[4m[0m[4m[0m[4m

model Subscription {
  id                   String             @id @default(uuid())
  userId               String
  tier                 SubscriptionTier   @default(FREE)
  price                Float              @default(0)
  startDate            DateTime           @default(now())
  endDate              DateTime?
  status               SubscriptionStatus @default(ACTIVE)
  stripeSubscriptionId String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model MasterCode {
  id          String   @id @default(uuid())
  code        String   @unique
  tier        SubscriptionTier @default(FREE)
  maxUses     Int      @default(1)
  usedCount   Int      @default(0)
  expiresAt   DateTime?
  revoked     Boolean  @default(false)
  createdBy   String
  createdAt   DateTime @default(now())

  // Relations
  creator User @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@map("master_codes")
}

// [4m Legal [0m [4m[0m[4m[0m[4m[0m[4m[0m[4m[0m[4m[0m[4m[0m[4m[0m[4m[0m[4m[0m[4m[0m[4m

model Contract {
  id          String         @id @default(uuid())
  userId      String
  type        ContractType
  content     String
  signedAt    DateTime?
  ipAddress   String?
  userAgent   String?
  status      ContractStatus @default(PENDING)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("contracts")
}

model DMCATakedown {
  id              String             @id @default(uuid())
  requesterEmail  String
  infringingUrl   String
  originalWorkUrl String?
  description     String?
  status          DMCATakedownStatus @default(PENDING)
  createdAt       DateTime           @default(now())
  resolvedAt      DateTime?

  @@map("dmca_takedowns")
}

// [4m Earnings & AI [0m [4m[0m[4m[0m[4m[0m[4m[0m[4m[0m[4m[0m[4m[0m[4m[0m[4m[0m[4m[0m[4m

model Earning {
  id          String        @id @default(uuid())
  userId      String
  amount      Float
  currency    String        @default("USD")
  source      EarningSource
  description String?
  status      EarningStatus @default(PENDING)
  paidAt      DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("earnings")
}

model AiGeneration {
  id           String             @id @default(uuid())
  userId       String
  type         AiGenerationType
  inputData    Json?
  outputUrl    String?
  costCredits  Int                @default(0)
  status       AiGenerationStatus @default(PENDING)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ai_generations")
}

// [4m Audit [0m [4m[0m[4m[0m[4m[0m[4m[0m[4m[0m[4m[0m[4m[0m[4m[0m[4m[0m[4m

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  // Relations
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// [4m Withdrawals [0m

model Withdrawal {
  id            String           @id @default(uuid())
  userId        String
  amount        Float
  currency      String           @default("USD")
  paymentMethod String
  status        WithdrawalStatus @default(PENDING)
  processedAt   DateTime?
  failureReason String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("withdrawals")
}

enum WithdrawalStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

// [4m Consent [0m [4m[0m[4m[0m[4m[0m[4m[0m[4m[0m[4m[0m[4m[0m[4m

model Consent {
  id                       String    @id @default(uuid())
  userId                   String    @unique
  aiConsentSigned          Boolean   @default(false)
  aiConsentSignedAt        DateTime?
  aiConsentSignature       String?
  likenessConsentSigned    Boolean   @default(false)
  likenessConsentSignedAt  DateTime?
  likenessConsentSignature String?
  guardianConsentSigned    Boolean   @default(false)
  guardianConsentSignedAt  DateTime?
  guardianName             String?
  guardianEmail            String?
  guardianPhone            String?
  relationship             String?
  guardianSignature        String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("consents")
}

// [4m DMCA Counter Notifications [0m

model DMCACounterNotification {
  id                    String   @id @default(uuid())
  dmcaTakedownId        String
  submitterEmail        String
  submitterName         String
  statement             String
  consentToJurisdiction Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relations
  dmcaTakedown DMCATakedown @relation(fields: [dmcaTakedownId], references: [id], onDelete: Cascade)

  @@map("dmca_counter_notifications")
}
